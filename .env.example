# Environment-variable reference. The application does not automatically load
# this file: export the values, pass `node --env-file=.env`, or configure them in
# your process manager. Every variable is optional; the development defaults put
# generated data under viewer/public/ so Vite can serve it.

# The production server (server/index.js)
#PORT=8080
#KZ_DIST_DIR=viewer/dist          # the built viewer to serve

# Where generated files live (src/config.js)
#KZ_DATA_DIR=/data/data           # maps.json, leaderboards.json, wrs.json
#KZ_MAPS_DIR=/data/maps           # converted map geometry, one .glb per map
#KZ_MODELS_DIR=/data/models       # the player character (ct.glb)
#KZ_TOOLS_DIR=/data/tools         # steamcmd downloads, Source2Viewer-CLI, DepotDownloader
#KZ_CS2_DIR=/data/tools/cs2       # the borrowed CS2 depot cache
#KZ_STATE_DIR=/state              # view counts — the one dir visitors write; keep it out of KZ_DATA_DIR

# The nightly refresh (server/index.js)
#KZ_REFRESH_HOUR=3                # local hour to run it
#KZ_REFRESH_MINUTE=30
#KZ_CONVERT_MAPS=true             # "false" skips map conversion entirely
#KZ_GEOMETRY_MINUTES=240          # time budget for converting maps per night
#KZ_TOOL_TIMEOUT_MINUTES=30       # timeout for each external tool process (1-1440)

# Public replay proxy limits (server/index.js)
#KZ_REPLAY_MAX_BYTES=8000000
#KZ_REPLAY_MAX_CONCURRENT=8
#KZ_REPLAY_REQUESTS_PER_MINUTE=60
